import random, torch, numpy as np
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader
from torchvision import datasets, transforms
import matplotlib.pyplot as plt
import pandas as pd
from IPython.display import display

# -------------------- 설정 --------------------
epochs = 50
batch_size = 128

lr = 1e-3
lr_gate = 1e-4  # 게이트 로짓 lr (별도)

hidden = 256
prune_ratio = 0.3
seed = 42

# ----------- Gate 학습 옵션(정확도 우선) -----------
# USE_INPUT_GATE = False          # ★ 정확도 우선이면 입력 게이트 OFF 강추
# PENALIZE_INPUT_GATE = False     # 입력 게이트 패널티(기본 OFF)

# warmup_epochs = 10              # 워밍업 동안 gate penalty=0
# gate_beta_max = 1e-5            # sparsity penalty 최종값 (너무 크면 정확도 떨어짐)
# target_keep = 0.70              # hidden gate 평균이 이 값보다 내려가면 벌점
# keep_beta = 1.0                 # hinge keep penalty 크기 (collapse 방지용)

# tau_start = 0.05                # 초반엔 gate 잘 열리게
# tau_end   = 0.30
# tau_anneal_epochs = 20

# ----------- Gate 학습 옵션(절감효과 나오게) -----------
USE_INPUT_GATE = True           # ★ 입력 게이트 ON (절감효과 핵심)
PENALIZE_INPUT_GATE = True      # ★ 입력 게이트도 패널티 적용

warmup_epochs = 15              # 워밍업 길게 (정확도 먼저 확보)
gate_beta_max = 3e-4            # ★ sparsity 압력 ↑ (기존 1e-5는 너무 약함)

target_keep = 0.90              # hidden은 최대한 유지(정확도 보호)
keep_beta = 2.0                 # hidden collapse 방지 강하게

tau_start = 0.60                # 초반엔 많이 열림
tau_end   = 0.90                # ★ 후반 hard threshold 강하게 (입력 게이트 닫힘 유도)
tau_anneal_epochs = 25          # 천천히 올려서 안정화

lr_gate = 5e-5                  # gate 로짓은 조금 더 천천히(급격 collapse 방지)


# -------------------- 시드 고정 --------------------
def set_seed(seed=42):
    print("시드 값:", seed)
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)

set_seed(seed)

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Using device:", device)

# -------------------- 스케줄 --------------------
def beta_schedule(epoch, warmup=10, beta_max=1e-5):
    # warmup 동안 0 → 이후 점진 증가
    if epoch < warmup:
        return 0.0
    t = (epoch - warmup) / max(1, (epochs - warmup))
    return beta_max * t

def tau_schedule(epoch):
    # 0~tau_anneal_epochs: tau_start → tau_end
    if epoch < tau_anneal_epochs:
        return tau_start + (tau_end - tau_start) * (epoch / tau_anneal_epochs)
    return tau_end

# -------------------- 모델 정의 --------------------
class MLP(nn.Module):
    def __init__(self, input_dim=784, hidden_dim=256, output_dim=10):
        super().__init__()
        self.fc1 = nn.Linear(input_dim, hidden_dim)
        self.fc2 = nn.Linear(hidden_dim, output_dim)
    def forward(self, x):
        x = x.view(x.size(0), -1)
        x = F.relu(self.fc1(x))
        return self.fc2(x)

class DropoutMLP(nn.Module):
    def __init__(self, input_dim=784, hidden_dim=256, output_dim=10, p=0.5):
        super().__init__()
        self.fc1 = nn.Linear(input_dim, hidden_dim)
        self.drop = nn.Dropout(p)
        self.fc2 = nn.Linear(hidden_dim, output_dim)
    def forward(self, x):
        x = x.view(x.size(0), -1)
        x = F.relu(self.fc1(x))
        x = self.drop(x)
        return self.fc2(x)

class GateLayer(nn.Module):
    def __init__(self, size, tau=0.5, init_logit=2.0):
        super().__init__()
        self.gate_logits = nn.Parameter(torch.ones(size) * init_logit)  # sigmoid(2)=0.88
        self.tau = float(tau)

    def forward(self, x):
        probs = torch.sigmoid(self.gate_logits)           # soft gate prob
        hard = (probs > self.tau).float()                 # hard mask
        gates = hard + (probs - hard).detach()            # STE
        return x * gates, probs

class DynamicGateMLP(nn.Module):
    def __init__(self, input_dim=784, hidden_dim=256, output_dim=10,
                 tau=0.3, use_input_gate=False):
        super().__init__()
        self.use_input_gate = use_input_gate

        if self.use_input_gate:
            self.gate_in = GateLayer(input_dim, tau=tau, init_logit=3.0)  # 입력은 더 열어두기
        else:
            self.gate_in = None

        self.fc1 = nn.Linear(input_dim, hidden_dim)
        self.gate_hid = GateLayer(hidden_dim, tau=tau, init_logit=2.0)
        self.fc2 = nn.Linear(hidden_dim, output_dim)

    def set_tau(self, tau):
        if self.gate_in is not None:
            self.gate_in.tau = float(tau)
        self.gate_hid.tau = float(tau)

    def forward(self, x):
        x = x.view(x.size(0), -1)

        probs_in = None
        if self.gate_in is not None:
            x, probs_in = self.gate_in(x)

        x = F.relu(self.fc1(x))             # ★ ReLU 먼저
        x, probs_hid = self.gate_hid(x)     # ★ ReLU 뒤에 hidden gate 적용 (안정적)
        logits = self.fc2(x)

        return logits, (probs_in, probs_hid)

# -------------------- 데이터 --------------------
transform = transforms.Compose([
    transforms.ToTensor(),
    transforms.Normalize((0.1307,), (0.3081,))
])
train_ds = datasets.MNIST("./data", train=True, download=True, transform=transform)
test_ds  = datasets.MNIST("./data", train=False, download=True, transform=transform)

train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)
test_loader  = DataLoader(test_ds, batch_size=512, shuffle=False)

# -------------------- Pruning (마스크 유지) --------------------
def apply_pruning_keep_mask(model, ratio=0.3):
    """
    fc1.weight의 작은 값 ratio 비율만큼 0으로 만들고,
    학습 중에도 계속 0 유지(마스크 적용).
    """
    with torch.no_grad():
        w_abs = model.fc1.weight.detach().abs().view(-1)
        thresh = torch.quantile(w_abs, ratio)
        mask = (model.fc1.weight.detach().abs() > thresh).float()
        model.register_buffer("fc1_mask", mask)
        model.fc1.weight.mul_(mask)
    return model

def apply_mask_if_exists(model):
    if hasattr(model, "fc1_mask"):
        with torch.no_grad():
            model.fc1.weight.mul_(model.fc1_mask)

# -------------------- 학습/평가 --------------------
def train_epoch(model, loader, opt, device, crit,
                beta_sparsity=0.0,
                target_keep=None,
                keep_beta=0.0,
                penalize_input_gate=False):
    model.train()
    total, correct = 0, 0

    for x, y in loader:
        x, y = x.to(device), y.to(device)
        opt.zero_grad()

        out = model(x)
        if isinstance(out, tuple):
            logits, (probs_in, probs_hid) = out

            loss = crit(logits, y)

            # ----- Keep penalty (collapse 방지) -----
            # mean(probs_hid)가 target_keep 아래로 떨어지면 벌점
            if (target_keep is not None) and (keep_beta > 0.0):
                p_hid_mean = probs_hid.mean()
                keep_loss = F.relu(target_keep - p_hid_mean) ** 2
                loss = loss + keep_beta * keep_loss

            # ----- Sparsity penalty (후반에 서서히 적용) -----
            # gate를 많이 열수록 페널티(=mean이 크면 페널티)
            if beta_sparsity > 0.0:
                loss = loss + beta_sparsity * probs_hid.mean()

                if penalize_input_gate and (probs_in is not None):
                    loss = loss + beta_sparsity * 0.1 * probs_in.mean()  # 입력은 약하게만

        else:
            logits = out
            loss = crit(logits, y)

        loss.backward()
        opt.step()

        # pruned mask 유지
        apply_mask_if_exists(model)

        correct += (logits.argmax(1) == y).sum().item()
        total += y.size(0)

    return correct / total

@torch.no_grad()
def test_epoch(model, loader, device):
    model.eval()
    total, correct = 0, 0
    pin_list, phid_list = [], []

    for x, y in loader:
        x, y = x.to(device), y.to(device)
        out = model(x)

        if isinstance(out, tuple):
            logits, (probs_in, probs_hid) = out
            if probs_in is not None:
                pin_list.append(probs_in.mean().item())
            phid_list.append(probs_hid.mean().item())
        else:
            logits = out

        correct += (logits.argmax(1) == y).sum().item()
        total += y.size(0)

    acc = correct / total
    mean_pin = (sum(pin_list)/len(pin_list)) if len(pin_list) > 0 else None
    mean_phid = (sum(phid_list)/len(phid_list)) if len(phid_list) > 0 else None
    return acc, (mean_pin, mean_phid)

# -------------------- FLOPs & Params --------------------
def compute_params(model):
    return sum(p.numel() for p in model.parameters() if p.requires_grad)

def compute_flops_baseline(hidden):
    # multiply+add ≈ 2 * (in*out)
    return int(2 * (784 * hidden + hidden * 10))

@torch.no_grad()
def gate_active_ratio(gate_layer):
    if gate_layer is None:
        return 1.0
    probs = torch.sigmoid(gate_layer.gate_logits)
    hard = (probs > gate_layer.tau).float()
    return hard.mean().item()

def compute_flops_dynamic_gate(model):
    D_in = 784
    H = model.fc1.out_features
    D_out = model.fc2.out_features

    r_in  = gate_active_ratio(model.gate_in)
    r_hid = gate_active_ratio(model.gate_hid)

    flops_fc1 = D_in * r_in * H
    flops_fc2 = H * r_hid * D_out
    flops = int(2 * (flops_fc1 + flops_fc2))
    return flops, r_in, r_hid

def compute_flops_pruned(hidden, prune_ratio):
    D_in, H, D_out = 784, hidden, 10
    flops_fc1 = D_in * (1 - prune_ratio) * H
    flops_fc2 = H * D_out
    return int(2 * (flops_fc1 + flops_fc2))

# ----------- 게이트 시각화 ----------------
def show_gate_matrix(model, target="hid", rows=16, cols=16):
    layer = model.gate_hid if target == "hid" else model.gate_in
    if layer is None:
        print(f"[{target}] gate layer is None (disabled).")
        return

    with torch.no_grad():
        probs = torch.sigmoid(layer.gate_logits).detach().cpu().numpy()
        hard  = (probs > layer.tau).astype(int)

    df_probs = pd.DataFrame(probs.reshape(1, -1))
    df_hard  = pd.DataFrame(hard.reshape(1, -1))

    print(f"\n[{target}] Gate probabilities (0~1):")
    display(df_probs)
    print(f"\n[{target}] Gate hard values (0/1):")
    display(df_hard)
    print(f"\n[{target}] Active gates: {df_hard.values.sum()} / {df_hard.size}")

    try:
        mat = hard.reshape(rows, cols)
        plt.imshow(mat, cmap="Greens", aspect="auto")
        plt.colorbar(label="Gate (0=off, 1=on)")
        plt.title(f"DynamicGate-MLP [{target}] Gate (0=off, 1=on)")
        plt.show()
    except Exception as e:
        print("Cannot reshape to matrix:", e)

# -------------------- 실행 --------------------
crit = nn.CrossEntropyLoss()
results = []
flops_base = compute_flops_baseline(hidden)

print("\n==================== Baseline MLP ====================")
mlp = MLP(hidden_dim=hidden).to(device)
opt = torch.optim.Adam(mlp.parameters(), lr=lr)

for e in range(epochs):
    tr = train_epoch(mlp, train_loader, opt, device, crit)
    te, _ = test_epoch(mlp, test_loader, device)
print("Baseline MLP acc:", te)

params = compute_params(mlp)
results.append(["Baseline MLP", te*100, 0.0, 0.0, params, flops_base])

print("\n==================== Dropout MLP ====================")
drop = DropoutMLP(hidden_dim=hidden, p=0.5).to(device)
opt_d = torch.optim.Adam(drop.parameters(), lr=lr)

for e in range(epochs):
    tr = train_epoch(drop, train_loader, opt_d, device, crit)
    te, _ = test_epoch(drop, test_loader, device)
print("Dropout MLP acc:", te)

params = compute_params(drop)
results.append(["Dropout MLP", te*100, 0.0, 0.0, params, flops_base])

print("\n==================== Pruned MLP ====================")
pruned = MLP(hidden_dim=hidden).to(device)
pruned = apply_pruning_keep_mask(pruned, prune_ratio)
opt_p = torch.optim.Adam(pruned.parameters(), lr=lr)

for e in range(epochs):
    tr = train_epoch(pruned, train_loader, opt_p, device, crit)
    te, _ = test_epoch(pruned, test_loader, device)
print("Pruned MLP acc:", te)

params = compute_params(pruned)
flops_pruned = compute_flops_pruned(hidden, prune_ratio)
flops_red_pct = 100.0 * (1.0 - flops_pruned / flops_base)
results.append(["Pruned MLP", te*100, 0.0, flops_red_pct, params, flops_pruned])

print("\n==================== DynamicGate-MLP ====================")
gate = DynamicGateMLP(hidden_dim=hidden, tau=tau_end, use_input_gate=USE_INPUT_GATE).to(device)

# 게이트 로짓 / 나머지 파라미터 분리해서 LR 다르게
gate_params = []
main_params = []
for name, p in gate.named_parameters():
    if "gate_logits" in name:
        gate_params.append(p)
    else:
        main_params.append(p)

opt_g = torch.optim.Adam([
    {"params": main_params, "lr": lr},
    {"params": gate_params, "lr": lr_gate},
])

def log_gate_ratios(model, epoch, cur_beta, cur_tau):
    r_in  = gate_active_ratio(model.gate_in)
    r_hid = gate_active_ratio(model.gate_hid)
    print(f"[epoch {epoch:02d}] beta={cur_beta:.2e}, tau={cur_tau:.3f} | r_in={r_in:.3f}, r_hid={r_hid:.3f}")

for e in range(epochs):
    cur_beta = beta_schedule(e, warmup=warmup_epochs, beta_max=gate_beta_max)
    cur_tau = tau_schedule(e)
    gate.set_tau(cur_tau)

    tr = train_epoch(
        gate, train_loader, opt_g, device, crit,
        beta_sparsity=cur_beta,
        target_keep=target_keep,
        keep_beta=keep_beta,
        penalize_input_gate=PENALIZE_INPUT_GATE
    )

    if (e+1) % 5 == 0:
        log_gate_ratios(gate, e+1, cur_beta, cur_tau)

    te, (pin, phid) = test_epoch(gate, test_loader, device)

print("Gate MLP acc:", te, "mean probs (in, hid):", pin, phid)

dg_flops, r_in, r_hid = compute_flops_dynamic_gate(gate)
flops_red_pct = 100.0 * (1.0 - dg_flops / flops_base)
params = compute_params(gate)
results.append(["DynamicGate-MLP", te*100, 0.0, flops_red_pct, params, dg_flops])

print(f"[Gate ratios] r_in={r_in:.3f}, r_hid={r_hid:.3f}")
print(f"[FLOPs] baseline={flops_base}, gated={dg_flops} (↓{flops_red_pct:.2f}%)")

# -------------------- 결과 표 --------------------
df = pd.DataFrame(results, columns=["Model","Accuracy(%)","Param Reduction(%)","FLOPs Reduction(%)","Params","FLOPs"])
display(df)

# Gate 히트맵 (hidden=256 → 16x16)
show_gate_matrix(gate, target="hid", rows=16, cols=16)
# show_gate_matrix(gate, target="in", rows=28, cols=28)  # 입력 게이트를 켰을 때만

# -------------------- 그래프 시각화 --------------------
models = df["Model"].tolist()

plt.figure(figsize=(12,4))

plt.subplot(1,3,1)
plt.bar(models, df["Accuracy(%)"])
plt.title("Accuracy (%)")
plt.ylabel("Accuracy (%)")
plt.xticks(rotation=20)

plt.subplot(1,3,2)
plt.bar(models, df["Params"])
plt.title("Number of Parameters")
plt.ylabel("Params")
plt.xticks(rotation=20)

plt.subplot(1,3,3)
plt.bar(models, df["FLOPs"])
plt.title("FLOPs (Computation Cost)")
plt.ylabel("FLOPs")
plt.xticks(rotation=20)

plt.suptitle("Model Comparison: Accuracy / Params / FLOPs", fontsize=14)
plt.tight_layout()
plt.show()


