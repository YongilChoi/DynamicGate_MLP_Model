import math, os, random
from dataclasses import dataclass
from typing import Dict, Tuple, List

import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader
from torchvision import datasets, transforms

import pandas as pd

#-------------------
# Preset
CAPACITY_FACTOR_VAL = 2.5


# -----------------------------
# 0) Repro / Device
# -----------------------------
SEED = 42
random.seed(SEED); np.random.seed(SEED)
torch.manual_seed(SEED); torch.cuda.manual_seed_all(SEED)

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
print("DEVICE:", DEVICE)

# -----------------------------
# 1) Data  (★ batch 줄여 drop 감소)
# -----------------------------
BATCH = 128   # was 256
transform = transforms.Compose([
    transforms.ToTensor(),
    transforms.Normalize((0.1307,), (0.3081,))
])

train_ds = datasets.MNIST(root="./data", train=True, download=True, transform=transform)
test_ds  = datasets.MNIST(root="./data", train=False, download=True, transform=transform)

train_loader = DataLoader(train_ds, batch_size=BATCH, shuffle=True, num_workers=2, pin_memory=True)
test_loader  = DataLoader(test_ds,  batch_size=BATCH, shuffle=False, num_workers=2, pin_memory=True)

# -----------------------------
# 2) Utilities: metrics
# -----------------------------
@torch.no_grad()
def accuracy(model: nn.Module, loader: DataLoader) -> float:
    model.eval()
    correct, total = 0, 0
    for x, y in loader:
        x, y = x.to(DEVICE), y.to(DEVICE)
        logits, aux = model(x, return_aux=True)
        pred = logits.argmax(dim=-1)
        correct += (pred == y).sum().item()
        total += y.numel()
    return correct / total

def mutual_information_from_counts(counts: np.ndarray) -> float:
    """
    counts: shape [E, C] (expert x class) integer counts
    MI(E;Y) = sum_e,y p(e,y) log( p(e,y) / (p(e)p(y)) )
    """
    total = counts.sum()
    if total == 0:
        return 0.0
    pxy = counts / total
    pe = pxy.sum(axis=1, keepdims=True)
    py = pxy.sum(axis=0, keepdims=True)
    eps = 1e-12
    ratio = (pxy + eps) / (pe @ py + eps)
    mi = (pxy * np.log(ratio)).sum()
    return float(mi)

@torch.no_grad()
def collect_conditional_stats(model: nn.Module, loader: DataLoader, n_experts: int = None) -> Dict[str, float]:
    """
    Collects:
      - DynamicGate: avg_active_ratio_g, corr(confidence, active_ratio)
      - MoE: expert_usage_entropy, expert_usage_cv, MI(expert;label)
    """
    model.eval()
    active_ratios = []
    confs = []

    expert_counts = None
    expert_class_counts = None

    for x, y in loader:
        x, y = x.to(DEVICE), y.to(DEVICE)
        logits, aux = model(x, return_aux=True)

        probs = F.softmax(logits, dim=-1)
        conf = probs.max(dim=-1).values  # confidence proxy
        confs.append(conf.detach().cpu().numpy())

        # DynamicGate signature
        if "gate_g" in aux:
            g = aux["gate_g"]  # [B, H] hard 0/1
            ar = g.float().mean(dim=-1)   # per-example active ratio
            active_ratios.append(ar.detach().cpu().numpy())

        # MoE signature (top-k 지원)
        if "top1_expert" in aux:
            top1 = aux["top1_expert"].detach().cpu().numpy()  # [B]
            if n_experts is None:
                n_experts = int(top1.max()) + 1

            if expert_counts is None:
                expert_counts = np.zeros((n_experts,), dtype=np.int64)
                expert_class_counts = np.zeros((n_experts, 10), dtype=np.int64)

            # usage entropy/cv는 top-k면 assignments 기준으로 카운트하는 게 더 자연스러움
            if "topk_experts" in aux:
                topk = aux["topk_experts"].detach().cpu().numpy()  # [B, K]
                for row in topk:
                    for e in row:
                        expert_counts[int(e)] += 1
            else:
                for e in top1:
                    expert_counts[int(e)] += 1

            # MI는 label과의 전문화를 보기 좋게 top-1 기준 유지
            for e, cls in zip(top1, y.detach().cpu().numpy()):
                expert_class_counts[int(e), int(cls)] += 1

    out = {}
    confs = np.concatenate(confs) if len(confs) else np.array([0.0])

    if len(active_ratios):
        ars = np.concatenate(active_ratios)
        out["avg_active_ratio_g"] = float(ars.mean())
        hardness = 1.0 - confs
        if ars.std() > 1e-12 and hardness.std() > 1e-12:
            out["corr_hardness_active"] = float(np.corrcoef(hardness, ars)[0, 1])
        else:
            out["corr_hardness_active"] = 0.0

    if expert_counts is not None:
        p = expert_counts / (expert_counts.sum() + 1e-12)
        entropy = -np.sum(p * np.log(p + 1e-12))
        out["expert_usage_entropy"] = float(entropy)

        mean = expert_counts.mean()
        std = expert_counts.std()
        out["expert_usage_cv"] = float(std / (mean + 1e-12))

        out["mi_expert_label"] = mutual_information_from_counts(expert_class_counts)

    return out

# -----------------------------
# 3) DynamicGate MLP (unchanged)
# -----------------------------
class StraightThroughGate(nn.Module):
    def __init__(self, in_dim: int, hidden_dim: int, tau: float = 1.0, theta: float = 0.05):
        super().__init__()
        self.gate = nn.Linear(in_dim, hidden_dim)
        self.tau = tau
        self.theta = theta

    def forward(self, h: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        z = self.gate(h)
        p = torch.sigmoid(z / self.tau)                 # soft prob
        g_hard = (p > self.theta).float()               # hard mask (0/1)
        g = g_hard + (p - p.detach())                   # STE
        return g, p, g_hard

class DynamicGateMLP(nn.Module):
    def __init__(self, in_dim=784, hidden=512, num_classes=10,
                 tau=1.0, theta=0.05):
        super().__init__()
        self.fc1 = nn.Linear(in_dim, hidden)
        self.gate = StraightThroughGate(hidden, hidden, tau=tau, theta=theta)
        self.fc2 = nn.Linear(hidden, num_classes)

    def forward(self, x, return_aux=False):
        x = x.view(x.size(0), -1)
        h = F.relu(self.fc1(x))
        g, p, g_hard = self.gate(h)
        h2 = h * g
        logits = self.fc2(h2)
        aux = {"gate_p": p, "gate_g": g_hard}
        return (logits, aux) if return_aux else (logits, {})

# -----------------------------
# 4) Switch-style MoE MLP (UPDATED)
#   - top-k routing (k=2)
#   - capacity_factor 증가 + cap 계산을 assignments(B*K) 기준으로
#   - z-loss 반환 (router 안정화)
#   - "모든 expert에서 drop" 되는 토큰은 identity fallback (h 유지)
# -----------------------------
class SwitchMoE(nn.Module):
    """
    Simple Switch-style MoE for MLP hidden:
      - router maps hidden -> E experts
      - top-k experts per sample (k>=1)
      - per-expert capacity; drop overflow assignments
      - output = sum_k gate_k * expert_k(h)
      - z-loss for router stabilization
    """
    def __init__(
        self,
        hidden_dim: int,
        n_experts: int = 8,
        top_k: int = 2,
        capacity_factor: float = CAPACITY_FACTOR_VAL,
        router_temperature: float = 1.0,
        use_random_capacity_drop: bool = True,
    ):
        super().__init__()
        assert top_k >= 1
        self.hidden_dim = hidden_dim
        self.n_experts = n_experts
        self.top_k = top_k
        self.capacity_factor = capacity_factor
        self.router_temperature = router_temperature
        self.use_random_capacity_drop = use_random_capacity_drop

        self.router = nn.Linear(hidden_dim, n_experts)
        self.experts = nn.ModuleList([
            nn.Sequential(
                nn.Linear(hidden_dim, hidden_dim),
                nn.ReLU(),
                nn.Linear(hidden_dim, hidden_dim),
            ) for _ in range(n_experts)
        ])

    def forward(self, h: torch.Tensor) -> Tuple[torch.Tensor, Dict]:
        B, H = h.shape

        router_logits = self.router(h)  # [B, E]
        # router temperature (optional)
        probs = F.softmax(router_logits / self.router_temperature, dim=-1)  # [B, E]

        # top-k
        topk_vals, topk_idx = torch.topk(probs, k=self.top_k, dim=-1)  # [B, K]
        # normalize selected gates to sum to 1 (important when k>1)
        topk_gates = topk_vals / (topk_vals.sum(dim=-1, keepdim=True) + 1e-9)  # [B, K]

        top1 = topk_idx[:, 0]  # [B]

        # Capacity per expert: based on total assignments = B * K
        # expected assignments per expert = (B*K)/E
        cap = max(1, int(math.ceil(self.capacity_factor * (B * self.top_k) / self.n_experts)))

        out = torch.zeros_like(h)
        assigned = torch.zeros((B,), device=h.device, dtype=torch.int32)
        dropped = 0

        # z-loss (Switch Transformer router stabilization)
        # typical: mean( logsumexp(logits)^2 )
        z_loss = torch.mean(torch.logsumexp(router_logits, dim=-1) ** 2)

        # Dispatch per expert
        # For expert e: find all (token_i, kpos) assignments where topk_idx[token_i, kpos] == e
        for e in range(self.n_experts):
            mask = (topk_idx == e)  # [B, K] bool
            if not mask.any():
                continue

            pairs = mask.nonzero(as_tuple=False)  # [N, 2] (token_i, kpos)
            n = pairs.size(0)
            if n > cap:
                if self.use_random_capacity_drop:
                    perm = torch.randperm(n, device=h.device)
                    keep_pairs = pairs[perm[:cap]]
                else:
                    keep_pairs = pairs[:cap]
                dropped += (n - cap)
                pairs = keep_pairs

            tok = pairs[:, 0]   # [N]
            kpos = pairs[:, 1]  # [N]
            w = topk_gates[tok, kpos].unsqueeze(-1)  # [N,1]

            expert_out = self.experts[e](h[tok])  # [N,H]
            out.index_add_(0, tok, expert_out * w)  # accumulate
            assigned.index_add_(0, tok, torch.ones_like(tok, dtype=torch.int32))

        # fallback: if a token got dropped from all experts, keep identity (no collapse)
        no_assign = (assigned == 0)
        if no_assign.any():
            out[no_assign] = h[no_assign]

        aux = {
            "router_probs": probs,          # [B,E]
            "router_logits": router_logits, # [B,E]
            "top1_expert": top1,            # [B]
            "topk_experts": topk_idx,       # [B,K]
            "topk_gates": topk_gates,       # [B,K]
            "dropped": torch.tensor(dropped, device=h.device),
            "z_loss": z_loss,
            "capacity": torch.tensor(cap, device=h.device),
        }
        return out, aux

def switch_load_balance_loss(router_probs: torch.Tensor, topk_experts: torch.Tensor, n_experts: int) -> torch.Tensor:
    """
    Switch-style aux loss (simplified but top-k aware):
      - load: fraction of assignments per expert (based on top-k picks)
      - importance: mean router prob mass per expert
      - loss = E * sum_e load_e * importance_e
    """
    B, E = router_probs.size()
    K = topk_experts.size(1)

    # load from assignments
    flat = topk_experts.reshape(-1)  # [B*K]
    counts = torch.bincount(flat, minlength=n_experts).float()  # [E]
    load = counts / (B * K + 1e-9)

    # importance from probs
    importance = router_probs.mean(dim=0)  # [E]

    return (load * importance).sum() * n_experts

class SwitchMoEMLP(nn.Module):
    def __init__(self, in_dim=784, hidden=512, num_classes=10,
                 n_experts=8, top_k=2, capacity_factor=CAPACITY_FACTOR_VAL, router_temperature=1.0):
        super().__init__()
        self.fc1 = nn.Linear(in_dim, hidden)
        self.moe = SwitchMoE(
            hidden,
            n_experts=n_experts,
            top_k=top_k,
            capacity_factor=capacity_factor,
            router_temperature=router_temperature,
            use_random_capacity_drop=True,
        )
        self.fc2 = nn.Linear(hidden, num_classes)
        self.n_experts = n_experts
        self.top_k = top_k

    def forward(self, x, return_aux=False):
        x = x.view(x.size(0), -1)
        h = F.relu(self.fc1(x))
        h2, aux_moe = self.moe(h)
        logits = self.fc2(F.relu(h2))
        return (logits, aux_moe) if return_aux else (logits, {})

# -----------------------------
# 5) Train loop (both models)
# -----------------------------
@dataclass
class TrainCfg:
    epochs: int = 8
    lr: float = 1e-3
    # DynamicGate
    gate_lambda: float = 5e-4
    warmup_epochs: int = 1
    # MoE
    lb_lambda: float = 1e-2   # load-balance strength
    z_lambda: float = 1e-3    # router z-loss strength (stabilization)

def train_one_epoch(model: nn.Module, loader: DataLoader, opt: torch.optim.Optimizer,
                    cfg: TrainCfg, epoch: int, model_kind: str) -> Dict[str, float]:
    model.train()
    total_loss = 0.0
    total_main = 0.0
    total_aux = 0.0
    total_items = 0
    total_dropped = 0

    for x, y in loader:
        x, y = x.to(DEVICE), y.to(DEVICE)
        opt.zero_grad(set_to_none=True)

        logits, aux = model(x, return_aux=True)
        main_loss = F.cross_entropy(logits, y)

        aux_loss = torch.tensor(0.0, device=DEVICE)

        if model_kind == "dynamicgate":
            # budget loss: mean(p)
            p = aux["gate_p"]  # [B,H]
            budget = p.mean()
            lam = 0.0 if epoch < cfg.warmup_epochs else cfg.gate_lambda
            aux_loss = lam * budget

        elif model_kind == "switchmoe":
            router_probs = aux["router_probs"]
            topk = aux["topk_experts"] if "topk_experts" in aux else aux["top1_expert"].unsqueeze(1)

            lb = switch_load_balance_loss(router_probs, topk, model.n_experts)
            z = aux.get("z_loss", torch.tensor(0.0, device=DEVICE))

            aux_loss = (cfg.lb_lambda * lb) + (cfg.z_lambda * z)
            total_dropped += int(aux.get("dropped", torch.tensor(0)).item())

        loss = main_loss + aux_loss
        loss.backward()
        opt.step()

        bsz = y.size(0)
        total_loss += float(loss.item()) * bsz
        total_main += float(main_loss.item()) * bsz
        total_aux  += float(aux_loss.item()) * bsz
        total_items += bsz

    return {
        "train_loss": total_loss / total_items,
        "train_main": total_main / total_items,
        "train_aux": total_aux / total_items,
        "train_dropped": total_dropped
    }

def run_experiment():
    cfg = TrainCfg()

    # ---- Models (MoE 설정: drop 최소화 우선)
    dyn = DynamicGateMLP(hidden=512, tau=1.0, theta=0.05).to(DEVICE)

    # ★ drop 줄이기 핵심: capacity_factor↑ + top_k=2 + batch↓(위에서)
    moe = SwitchMoEMLP(
        hidden=512,
        n_experts=8,
        top_k=2,                # k=2로 overflow 완화
        capacity_factor=CAPACITY_FACTOR_VAL,    # cap↑ => dropped 거의 0 목표
        router_temperature=1.0, # 필요시 1.2~2.0로 올려 exploration 유도 가능
    ).to(DEVICE)

    opt_dyn = torch.optim.AdamW(dyn.parameters(), lr=cfg.lr)
    opt_moe = torch.optim.AdamW(moe.parameters(), lr=cfg.lr)

    rows = []

    for epoch in range(cfg.epochs):
        # ---- Train ----
        m_dyn = train_one_epoch(dyn, train_loader, opt_dyn, cfg, epoch, "dynamicgate")
        m_moe = train_one_epoch(moe, train_loader, opt_moe, cfg, epoch, "switchmoe")

        # ---- Eval ----
        acc_dyn = accuracy(dyn, test_loader)
        acc_moe = accuracy(moe, test_loader)

        stats_dyn = collect_conditional_stats(dyn, test_loader)
        stats_moe = collect_conditional_stats(moe, test_loader, n_experts=moe.n_experts)

        row_dyn = {"epoch": epoch, "model": "DynamicGateMLP", "test_acc": acc_dyn, **m_dyn, **stats_dyn}
        row_moe = {"epoch": epoch, "model": "SwitchMoE_MLP",   "test_acc": acc_moe, **m_moe, **stats_moe}
        rows.extend([row_dyn, row_moe])

        print(f"[{epoch}] Dyn acc={acc_dyn:.4f}  active_g={row_dyn.get('avg_active_ratio_g', float('nan')):.3f}  corr(hard,act)={row_dyn.get('corr_hardness_active', float('nan')):.3f}")
        print(f"[{epoch}] MoE acc={acc_moe:.4f}  entropy={row_moe.get('expert_usage_entropy', float('nan')):.3f}  cv={row_moe.get('expert_usage_cv', float('nan')):.3f}  MI={row_moe.get('mi_expert_label', float('nan')):.3f}  dropped={row_moe.get('train_dropped',0)}")

    df = pd.DataFrame(rows)
    df.to_csv("results.csv", index=False)
    print("\nSaved -> results.csv")
    return df

df = run_experiment()
df.tail(6)
