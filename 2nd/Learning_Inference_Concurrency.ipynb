# ===== Colab Single-Cell: DynamicGate vs MoE (Hard/Soft/Anneal) + Online Router-Only Adaptation =====
import os, math, random, time
import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
from torchvision import datasets, transforms
from torch.utils.data import DataLoader, Subset
import matplotlib.pyplot as plt

# ----------------------------
# 0) Repro + Device
# ----------------------------
def set_seed(seed=42):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
set_seed(42)

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Device:", device)

# ----------------------------
# 1) Data (MNIST)
# ----------------------------
BATCH = 500
transform = transforms.Compose([transforms.ToTensor()])

train_ds = datasets.MNIST(root="./data", train=True, download=True, transform=transform)
test_ds  = datasets.MNIST(root="./data", train=False, download=True, transform=transform)

# Keep it fast: optionally subsample train for quick runs
# Comment out if you want full training.
train_idx = list(range(len(train_ds)))
random.shuffle(train_idx)
train_ds = Subset(train_ds, train_idx[:30000])  # 30k for speed

train_loader = DataLoader(train_ds, batch_size=BATCH, shuffle=True, num_workers=2, pin_memory=True)
test_loader  = DataLoader(test_ds,  batch_size=BATCH, shuffle=False, num_workers=2, pin_memory=True)

# ----------------------------
# 2) Drift function (noise + cheap blur)
# ----------------------------
def cheap_blur(x, k=3):
    # depthwise conv blur (k x k average), x: [B,1,28,28]
    w = torch.ones(1, 1, k, k, device=x.device) / (k*k)
    x_pad = F.pad(x, (k//2, k//2, k//2, k//2), mode="reflect")
    return F.conv2d(x_pad, w)

def apply_drift(x, noise_std=0.5, blur_k=3):
    # x in [0,1]
    x2 = x + torch.randn_like(x) * noise_std
    x2 = torch.clamp(x2, 0, 1)
    if blur_k is not None and blur_k > 1:
        x2 = cheap_blur(x2, k=blur_k)
    return torch.clamp(x2, 0, 1)

# ----------------------------
# 3) Utility: Freeze/Unfreeze gate/router parameters only
# ----------------------------
def freeze_except_gate(model):
    for n, p in model.named_parameters():
        p.requires_grad = ("gate" in n) or ("router" in n)

def count_trainable(model):
    return sum(p.numel() for p in model.parameters() if p.requires_grad)

# ----------------------------
# 4) Metrics helpers
# ----------------------------
@torch.no_grad()
def accuracy(model, loader, drift=False):
    model.eval()
    correct, total = 0, 0
    for x, y in loader:
        x, y = x.to(device), y.to(device)
        if drift:
            x = apply_drift(x)
        logits, aux = model(x)
        pred = logits.argmax(dim=1)
        correct += (pred == y).sum().item()
        total += y.numel()
    return correct / total

def flip_rate(prev_route, route):
    # prev_route, route: LongTensor [B] (expert index) or Bool mask [B,D]
    if prev_route is None:
        return None
    if route.dtype == torch.long:
        return (route != prev_route).float().mean().item()
    else:
        return (route != prev_route).float().mean().item()

# Simple FLOPs proxy: proportional to active units ratio per gated layer
def flops_proxy(active_ratio, base=1.0):
    return base * active_ratio

# ----------------------------
# 5) Models
# ----------------------------
class DenseMLP(nn.Module):
    def __init__(self, hidden=256):
        super().__init__()
        self.fc1 = nn.Linear(784, hidden)
        self.fc2 = nn.Linear(hidden, 10)

    def forward(self, x):
        x = x.view(x.size(0), -1)
        h = F.relu(self.fc1(x))
        out = self.fc2(h)
        aux = {"route": None, "active_ratio": 1.0}
        return out, aux

class DynamicGateLayer(nn.Module):
    """
    Weight/Unit-level gating on hidden activations (not expert blocks).
    - mode: soft / hard / anneal
    - gate: produces per-unit scores
    """
    def __init__(self, dim, mode="soft", k_ratio=0.3, temperature=1.0):
        super().__init__()
        self.gate = nn.Linear(dim, dim)  # router params θ
        self.mode = mode
        self.k_ratio = k_ratio
        self.temperature = temperature

    def forward(self, h):
        score = self.gate(h)  # [B,D]
        if self.mode == "soft":
            mask = torch.sigmoid(score / self.temperature)
        elif self.mode == "hard":
            k = max(1, int(h.size(1) * self.k_ratio))
            topk = torch.topk(score, k, dim=1).indices
            mask = torch.zeros_like(score) # mask initially has requires_grad=False
            mask.scatter_(1, topk, 1.0) # In-place operation on a non-requires_grad tensor
            # For hard gating to be trainable, a straight-through estimator (STE) is usually needed.
            # For now, this will effectively make `dg.gate` not receive gradients directly via `mask`.
            # However, the broader RuntimeError (loss doesn't require grad) is addressed by ensuring ALL params can potentially flow gradients.
        elif self.mode == "anneal":
            mask = torch.sigmoid(score / self.temperature)
        else:
            raise ValueError("Unknown mode")
        h2 = h * mask
        active_ratio = mask.mean().item()
        return h2, mask, active_ratio

class DGMLP(nn.Module):
    def __init__(self, hidden=256, mode="soft", k_ratio=0.3, temperature=1.0):
        super().__init__()
        self.fc1 = nn.Linear(784, hidden)
        self.dg  = DynamicGateLayer(hidden, mode=mode, k_ratio=k_ratio, temperature=temperature)
        self.fc2 = nn.Linear(hidden, 10)
        self.mode = mode

    def forward(self, x):
        x = x.view(x.size(0), -1)
        h = F.relu(self.fc1(x))
        h2, mask, ar = self.dg(h)
        out = self.fc2(h2)
        aux = {"route": mask.detach(), "active_ratio": ar}
        return out, aux

class MoE_MLP(nn.Module):
    """
    Expert-block routing baseline.
    - Experts are independent linear->relu->linear blocks from hidden to hidden.
    - Router chooses expert(s).
    Variants:
      - moe_top1: hard top-1 (Switch-like)
      - moe_soft: weighted mixture across all experts (compute heavier)
    """
    def __init__(self, hidden=256, n_experts=4, variant="moe_top1", temperature=1.0):
        super().__init__()
        self.fc1 = nn.Linear(784, hidden)
        self.router = nn.Linear(hidden, n_experts)  # router params θ (expert-level)
        self.experts = nn.ModuleList([
            nn.Sequential(nn.Linear(hidden, hidden), nn.ReLU(), nn.Linear(hidden, hidden))
            for _ in range(n_experts)
        ])
        self.fc2 = nn.Linear(hidden, 10)
        self.variant = variant
        self.temperature = temperature
        self.n_experts = n_experts

    def forward(self, x):
        x = x.view(x.size(0), -1)
        h = F.relu(self.fc1(x))
        logits_r = self.router(h)  # [B,E]

        if self.variant == "moe_top1":
            idx = torch.argmax(logits_r, dim=1)  # [B]
            # Execute only selected expert per sample (loop for simplicity; MNIST small)
            h2 = torch.zeros_like(h)
            for e in range(self.n_experts):
                mask = (idx == e)
                if mask.any():
                    h2[mask] = self.experts[e](h[mask])
            # FLOPs proxy: ~ 1 expert / E used? Actually compute ~1 expert block always per sample
            active_ratio = 1.0 / self.n_experts  # proxy for "fraction of experts used"
            route = idx.detach()

        elif self.variant == "moe_soft":
            w = F.softmax(logits_r / self.temperature, dim=1)  # [B,E]
            # Execute all experts then weight-sum (heavier compute)
            outs = []
            for e in range(self.n_experts):
                outs.append(self.experts[e](h))  # [B,H]
            stacked = torch.stack(outs, dim=1)  # [B,E,H]
            h2 = (w.unsqueeze(-1) * stacked).sum(dim=1)  # [B,H]
            active_ratio = 1.0  # uses all experts (compute heavy)
            route = torch.argmax(w, dim=1).detach()

        else:
            raise ValueError("Unknown MoE variant")

        out = self.fc2(h2)
        aux = {"route": route, "active_ratio": active_ratio}
        return out, aux

# ----------------------------
# 6) Train / Evaluate / Online Adapt
# ----------------------------
def train_offline(model, epochs=20, lr=1e-3):
    model.to(device)
    model.train()
    opt = torch.optim.Adam(model.parameters(), lr=lr)
    for ep in range(epochs):
        t0 = time.time()
        total_loss = 0.0
        for x, y in train_loader:
            x, y = x.to(device), y.to(device)
            logits, aux = model(x)
            loss = F.cross_entropy(logits, y)
            opt.zero_grad()
            loss.backward()
            opt.step()
            total_loss += loss.item() * y.size(0)
        total_loss /= len(train_loader.dataset)
        print(f"  [offline] ep {ep+1}/{epochs} loss={total_loss:.4f} time={time.time()-t0:.1f}s")
    return model

@torch.no_grad()
def eval_routing_stats(model, loader, drift=False, max_batches=30):
    model.eval()
    prev_route = None
    flips = []
    ars = []
    for bi, (x, y) in enumerate(loader):
        if bi >= max_batches:
            break
        x = x.to(device)
        if drift:
            x = apply_drift(x)
        logits, aux = model(x)
        route = aux["route"]
        ar = aux["active_ratio"]
        ars.append(ar)
        if route is not None:
            fr = flip_rate(prev_route, route)
            if fr is not None:
                flips.append(fr)
            prev_route = route
    flip_avg = float(np.mean(flips)) if len(flips) else None
    ar_avg = float(np.mean(ars)) if len(ars) else 1.0
    return flip_avg, ar_avg

def online_adapt_router_only(model, steps=200, lr=1e-4, drift=True):
    """
    Online adaptation loop:
    - Freeze all except gate/router params (θ)
    - Update θ on streaming batches (here from train_loader iterator)
    """
    model.to(device)

    # Store original requires_grad states for ALL parameters
    original_param_states = {}
    for n, p in model.named_parameters():
        original_param_states[n] = p.requires_grad

    trainable_params_for_optimizer = []
    for n, p in model.named_parameters():
        if ("gate" in n) or ("router" in n):
            p.requires_grad = True # Explicitly ensure gate/router params are trainable
            trainable_params_for_optimizer.append(p)
        else:
            # Crucial: Temporarily set ALL other parameters to True to enable gradient flow
            # This allows gradients to propagate through frozen layers to the trainable gate/router parameters.
            p.requires_grad = True

    trainable_theta = sum(p.numel() for p in trainable_params_for_optimizer)

    if trainable_theta == 0:
        print(f"  [Online Adapt] No trainable gate/router parameters found for {type(model).__name__}. Skipping.")
        # Restore original requires_grad states before returning
        for n, p in model.named_parameters():
            p.requires_grad = original_param_states[n]
        return [], 0

    opt = torch.optim.Adam(trainable_params_for_optimizer, lr=lr) # Optimizer only sees these

    model.train() # Set model to training mode

    it = iter(train_loader)
    losses = []
    for t in range(steps):
        try:
            x, y = next(it)
        except StopIteration:
            it = iter(train_loader)
            x, y = next(it)
        x, y = x.to(device), y.to(device)
        if drift:
            x = apply_drift(x)
        logits, aux = model(x)
        loss = F.cross_entropy(logits, y)

        opt.zero_grad()
        loss.backward() # This will now work as logits.requires_grad will be True
        opt.step()
        losses.append(loss.item())

    # After online adaptation, restore the requires_grad states to their original configuration.
    # This ensures consistency for subsequent evaluations or other operations.
    for n, p in model.named_parameters():
        p.requires_grad = original_param_states[n]

    return losses, trainable_theta

# ----------------------------
# 7) Run experiment
# ----------------------------
models = {
    "Dense": DenseMLP(hidden=256),
    "DG-Hard": DGMLP(hidden=256, mode="hard", k_ratio=0.3, temperature=1.0),
    "DG-Soft": DGMLP(hidden=256, mode="soft", k_ratio=0.3, temperature=1.0),
    "DG-Anneal": DGMLP(hidden=256, mode="anneal", k_ratio=0.3, temperature=3.0),  # start higher T
    "MoE-Top1": MoE_MLP(hidden=256, n_experts=4, variant="moe_top1", temperature=1.0),
    "MoE-Soft": MoE_MLP(hidden=256, n_experts=4, variant="moe_soft", temperature=1.0),
}

OFFLINE_EPOCHS = 10
ONLINE_STEPS   = 200
ONLINE_LR      = 2e-4

results = {}
curves = {}

print("\n=== Offline Training ===")
for name, m in models.items():
    print(f"\nModel: {name}")
    m = train_offline(m, epochs=OFFLINE_EPOCHS, lr=1e-3)
    models[name] = m

print("\n=== Eval (Before Online Adaptation) ===")
for name, m in models.items():
    clean_acc = accuracy(m, test_loader, drift=False)
    drift_acc = accuracy(m, test_loader, drift=True)
    # Removed: The freeze_except_gate call below sets the requires_grad states as needed for eval_routing_stats
    # Removed: freeze_except_gate(m) # Apply freezing strategy for proper metric calculation of trainable params
    flip_clean, ar_clean = eval_routing_stats(m, test_loader, drift=False)
    flip_drift, ar_drift = eval_routing_stats(m, test_loader, drift=True)

    results[name] = {
        "clean_acc": clean_acc,
        "drift_acc": drift_acc,
        "flip_clean": flip_clean,
        "flip_drift": flip_drift,
        "ar_clean": ar_clean,
        "ar_drift": ar_drift,
        "adapt_acc": None,
        "flops_clean": flops_proxy(ar_clean),
        "flops_drift": flops_proxy(ar_drift),
        "trainable_theta": None,
    }

print("\n=== Online Adaptation (Router/Gate θ only, on drifted stream) ===")
for name, m in models.items():
    # Anneal schedule: decrease temperature during online adaptation for DG-Anneal
    if name == "DG-Anneal":
        # simple anneal: modify temperature gradually inside adaptation steps by wrapping forward isn't trivial;
        # easiest: just set a lower temperature for "harder" decisions after adaptation.
        pass

    losses, trainable_theta = online_adapt_router_only(m, steps=ONLINE_STEPS, lr=ONLINE_LR, drift=True)
    curves[name] = losses
    results[name]["trainable_theta"] = trainable_theta

    # For anneal model, lower temperature after adaptation to show "soft->hard" effect
    if name == "DG-Anneal":
        m.dg.temperature = 1.0

    # Re-apply freeze_except_gate to set parameters to non-trainable for subsequent evaluations
    # as online_adapt_router_only temporarily changed requires_grad states.
    freeze_except_gate(m)
    adapt_acc = accuracy(m, test_loader, drift=True)
    results[name]["adapt_acc"] = adapt_acc

print("\n=== Final Summary Table ===")
print(f"{'Model':<10} | {'CleanAcc':>8} | {'DriftAcc':>8} | {'AdaptAcc':>8} | {'Flip(drift)':>10} | {'AR(drift)':>8} | {'FLOPs~':>6} | {'θ params':>8}")
print("-"*95)
for name, r in results.items():
    fd = r["flip_drift"]
    fd_str = "None" if fd is None else f"{fd:.3f}"
    print(f" {name:<9} | {r['clean_acc']*100:8.2f} | {r['drift_acc']*100:8.2f} | {r['adapt_acc']*100:8.2f} | {fd_str:>10} | {r['ar_drift']:8.3f} | {r['flops_drift']:6.2f} | {r['trainable_theta']:8d}")

# ----------------------------
# 8) Plots
# ----------------------------
# Loss curves (online adaptation)
plt.figure()
for name, loss in curves.items():
    if loss: # Only plot if there are losses (i.e., online adaptation actually ran)
        plt.plot(loss, label=name)
plt.title("Online Adaptation Loss (θ-only)")
plt.xlabel("Step")
plt.ylabel("CE Loss")
plt.legend()
plt.show()

# Bar chart: drift acc before/after
names = list(results.keys())
drift_before = [results[n]["drift_acc"]*100 for n in names]
drift_after  = [results[n]["adapt_acc"]*100 for n in names]

x = np.arange(len(names))
plt.figure(figsize=(12,4))
plt.bar(x - 0.2, drift_before, width=0.4, label="Drift (before)")
plt.bar(x + 0.2, drift_after,  width=0.4, label="Drift (after θ-only)")
plt.xticks(x, names, rotation=30, ha="right")
plt.title("Accuracy under Drift: Before vs After θ-only Online Adaptation")
plt.ylabel("Accuracy (%)")
plt.legend()
plt.tight_layout()
plt.show()

# FLOPs proxy under drift
flops = [results[n]["flops_drift"] for n in names]
plt.figure(figsize=(12,4))
plt.bar(np.arange(len(names)), flops)
plt.xticks(np.arange(len(names)), names, rotation=30, ha="right")
plt.title("Compute Proxy (FLOPs~) under Drift (lower is cheaper)")
plt.ylabel("FLOPs proxy")
plt.tight_layout()
plt.show()

# Flip rate under drift (routing stability)
flip_vals = []
for n in names:
    v = results[n]["flip_drift"]
    flip_vals.append(0.0 if v is None else v)
plt.figure(figsize=(12,4))
plt.bar(np.arange(len(names)), flip_vals)
plt.xticks(np.arange(len(names)), names, rotation=30, ha="right")
plt.title("Routing Flip Rate under Drift (higher = less stable)")
plt.ylabel("Flip rate")
plt.tight_layout()
plt.show()

print("\nDone. Tip: Increase OFFLINE_EPOCHS to 5-10 for clearer separation, or switch to CIFAR-10 for stronger evidence.")
